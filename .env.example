# Copie este arquivo para ".env" e preencha os valores NO SEU COMPUTADOR.
# O arquivo ".env" NUNCA vai para o Git (está no .gitignore).
# Este arquivo de exemplo não deve conter nenhum valor secreto de verdade.

# --- Aplicação (Fase 1) ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# --- Banco de dados (docker-compose.yml, Fase 1) ---
# Invente uma senha forte e diferente para cada ambiente.
POSTGRES_USER=auth_admin
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=auth_system
# Usuário da API (permissões mínimas, criado na Fase 1)
DATABASE_URL=postgres://auth_app:troque-esta-senha@127.0.0.1:5432/auth_system

# --- E-mail (Fase 3) ---
# Em desenvolvimento usamos o Mailpit (docker-compose.yml): sem login, sem envio real.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Auth System <no-reply@localhost>"

# --- Sessões e segredos (Fase 4) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=gere-um-valor-aleatorio-aqui
