# EditorConfig: faz o VS Code (com a extensão EditorConfig) e outros editores
# usarem as mesmas regras básicas de espaçamento e quebra de linha.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
